.hero.compact {
  height: 240rpx;
}

.page-header {
  display: grid;
  grid-template-columns: 88rpx 1fr;
  gap: 20rpx;
  align-items: center;
  padding: 26rpx 28rpx;
}

.header-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #2f8b45;
  background: #eaf6e8;
  font-weight: 800;
}

.header-copy {
  display: block;
  margin-top: 8rpx;
  color: #657067;
  font-size: 24rpx;
  line-height: 1.45;
}

.atlas-list {
  display: grid;
  gap: 18rpx;
}

.atlas-row {
  height: 136rpx;
  display: grid;
  grid-template-columns: 96rpx 1fr 116rpx;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  text-align: left;
}

.atlas-row.selected {
  border-color: #3b9b4d;
  background: #f4fff2;
}

.atlas-row image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
}

.atlas-name {
  display: block;
  margin-bottom: 8rpx;
  color: #1f271f;
  font-size: 30rpx;
  font-weight: 800;
}

.atlas-row text {
  color: #657067;
  font-size: 24rpx;
}

.atlas-profit {
  color: #277a3d;
  font-size: 30rpx;
  font-weight: 800;
  text-align: right;
}

.detail-panel {
  display: grid;
  grid-template-columns: 1fr 170rpx;
  gap: 24rpx;
  align-items: center;
  margin-top: 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef8eb 100%);
}

.detail-name {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.detail-copy {
  display: block;
  margin-top: 12rpx;
  color: #657067;
  font-size: 26rpx;
  line-height: 1.45;
}

.detail-panel image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 28rpx;
}

.mutations {
  margin-top: 24rpx;
  padding: 24rpx;
}

.board-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.mutation-row {
  display: grid;
  grid-template-columns: 38rpx 1fr 150rpx 70rpx;
  gap: 10rpx;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid #edf1ea;
}

.spark {
  color: #8e62d9;
  font-size: 30rpx;
}

.mutation-name {
  font-size: 26rpx;
  font-weight: 800;
}

.mutation-row text {
  color: #6d756d;
  font-size: 24rpx;
}

.mutation-bonus {
  color: #d66b30;
  font-size: 26rpx;
  font-weight: 800;
}
