.hero.compact {
  height: 240rpx;
}

.page-header {
  display: grid;
  grid-template-columns: 88rpx 1fr;
  gap: 20rpx;
  align-items: center;
  padding: 26rpx 28rpx;
}

.header-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #2f8b45;
  background: #eaf6e8;
  font-weight: 800;
}

.header-copy {
  display: block;
  margin-top: 8rpx;
  color: #657067;
  font-size: 24rpx;
  line-height: 1.45;
}

.calculator-card {
  padding: 28rpx;
}

.calc-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.calc-title {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sliders {
  color: #2f8b45;
  font-size: 42rpx;
  font-weight: 800;
}

.calc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 2rpx solid #edf1ea;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fbfdf9;
}

.calc-grid view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 10rpx;
}

.calc-grid view + view {
  border-left: 2rpx solid #edf1ea;
}

.calc-grid text {
  color: #758078;
  font-size: 22rpx;
}

.calc-strong {
  color: #24803c;
  font-size: 32rpx;
  font-weight: 800;
}

.plan-list {
  display: grid;
  gap: 20rpx;
  margin-top: 24rpx;
}

.plan-card {
  display: grid;
  grid-template-columns: 68rpx 1fr 160rpx;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
}

.rank {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #2f8b45;
  font-size: 30rpx;
  font-weight: 800;
}

.plan-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plan-main text:first-child {
  color: #172019;
  font-size: 30rpx;
  font-weight: 800;
}

.plan-main text:last-child {
  color: #657067;
  font-size: 24rpx;
  line-height: 1.35;
}

.plan-profit {
  color: #b36a18;
  font-size: 28rpx;
  font-weight: 800;
  text-align: right;
}

.weekend-card {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 156rpx;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #edcf91;
  border-radius: 32rpx;
  color: #814a0f;
  background: linear-gradient(180deg, #fffaf0, #fff6e4);
}

.calendar-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #d89725;
  border-radius: 12rpx;
  color: #d89725;
  font-weight: 800;
}

.weekend-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.weekend-main text:first-child {
  font-size: 30rpx;
  font-weight: 800;
}

.weekend-main text:last-child {
  font-size: 24rpx;
  line-height: 1.35;
}

.weekend-card button {
  height: 64rpx;
  border-radius: 999rpx;
  color: #9b5c12;
  background: #ffe8bd;
  font-size: 24rpx;
  font-weight: 800;
}
