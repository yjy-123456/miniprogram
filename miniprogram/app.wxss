page {
  min-height: 100vh;
  color: #172019;
  background: #fbfcf8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #fbfcf8;
}

.hero {
  position: relative;
  height: 322rpx;
  padding: 92rpx 32rpx 0;
  color: #fff;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(35, 99, 50, 0.7), rgba(35, 99, 50, 0.12));
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 54rpx;
  line-height: 1.05;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-bottom: 18rpx;
  font-size: 31rpx;
  color: rgba(255, 255, 255, 0.92);
}

.date-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(36, 102, 49, 0.76);
  font-size: 26rpx;
}

.content {
  position: relative;
  z-index: 2;
  margin-top: -20rpx;
  padding: 28rpx 36rpx 40rpx;
  border-radius: 48rpx 48rpx 0 0;
  background: #fbfcf8;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.page-header > view:last-child {
  flex: 1;
  min-width: 0;
}

.card {
  border: 2rpx solid #d9e1d6;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 44rpx rgba(39, 69, 42, 0.07);
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #172019;
}

.muted {
  color: #657067;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 78rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(180deg, #3e9148, #28753d);
  font-size: 30rpx;
  font-weight: 800;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #2f7e42;
  background: #eaf6e8;
  font-size: 24rpx;
  font-weight: 700;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
  white-space: nowrap;
}

.filter-chip {
  flex: 1;
  min-width: 112rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfe7dc;
  border-radius: 999rpx;
  color: #617065;
  background: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.filter-chip.active {
  color: #fff;
  border-color: #2f8b45;
  background: linear-gradient(180deg, #45a453, #2f8b45);
}
